; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are loss-prone and hard to understand.

config_version=5

[application]

config/name="Racing Game"
config/version="1.0.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.1", "forward_plus")
config/icon="res://icon.svg"

[debug]

gdscript/warnings/unused_variable=1
gdscript/warnings/unused_parameter=1

[physics]

3d/default_gravity=9.8
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0

[rendering]

renderer/rendering_method="forward_plus"
environment/ambient_light/enabled=true
environment/ambient_light/energy=1.0